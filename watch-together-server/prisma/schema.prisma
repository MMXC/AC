// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Room {
  id         String  @id @db.VarChar(32)
  name       String  @default("未命名房间") @db.VarChar(255)
  /// 房主用户的唯一标识（Single Source of Truth），在房间创建后不可变更。
  /// 任何需要判断“是否为房主”的业务逻辑应以此字段为准，而不是直接依赖 RoomMember.isHost。
  hostId     String  @db.VarChar(32)
  /// 当前房主浏览器中实际打开的共享页面 URL（Single Source of Truth）。
  /// 所有客户端应以该字段为最终的共享 URL 来源，WebSocket 状态同步中的 URL 也必须与之保持一致。
  currentUrl String? @db.Text
  /// 当前被授予“操作来源”的成员用户 ID（Single Source of Truth）。
  /// 该字段仅决定“谁的输入会被转发到房主浏览器执行”，不会改变 Room.hostId 所代表的房主身份。
  /// 若为 null，表示只有房主自己可以操作页面；若不为 null，则应指向某个 RoomMember.userId。
  operationSourceUserId String? @db.VarChar(32)
  inviteLink            String? @db.VarChar(500)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?
  settings              Json?

  // Relations
  members    RoomMember[]
  messages   Message[]
  events     RoomEvent[]

  @@index([hostId])
  @@index([operationSourceUserId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("rooms")
}

model RoomMember {
  id           BigInt   @id @default(autoincrement())
  roomId       String   @db.VarChar(32)
  userId       String   @db.VarChar(32)
  nickname     String   @db.VarChar(100)
  /// 标记该成员在客户端显示为“房主”与否，应始终与 Room.hostId 一致：
  /// 当且仅当 userId === Room.hostId 时为 true，其它成员必须为 false。
  /// 该字段属于从 Room.hostId 派生的便捷标记，不应作为房主身份的唯一真源。
  isHost       Boolean  @default(false)
  joinedAt     DateTime @default(now())
  leftAt       DateTime?
  lastActiveAt DateTime @default(now())

  // Relations
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@index([lastActiveAt])
  @@map("room_members")
}

model Message {
  id        String   @id @db.VarChar(32)
  roomId    String   @db.VarChar(32)
  userId    String   @db.VarChar(32)
  nickname  String   @db.VarChar(100)
  content   String   @db.Text
  createdAt DateTime @default(now())

  // Relations
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("messages")
}

model RoomEvent {
  id        BigInt   @id @default(autoincrement())
  roomId    String   @db.VarChar(32)
  eventType String   @db.VarChar(50) // URL_CHANGED, MEMBER_JOINED, etc.
  userId    String?  @db.VarChar(32)
  eventData Json?
  createdAt DateTime @default(now())

  // Relations
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt(sort: Desc)])
  @@index([eventType])
  @@map("room_events")
}
