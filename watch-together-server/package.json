{
  "name": "watch-together-server",
  "version": "0.1.0",
  "main": "dist/server.js",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "prisma": "^5.22.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {},
  "prisma": {
    "seed": "node scripts/seed.js"
  },
  "scripts": {
