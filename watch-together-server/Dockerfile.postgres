# PostgreSQL Database Dockerfile
# 
# 此 Dockerfile 基于官方 PostgreSQL 镜像，用于自定义数据库配置
# 如果需要自定义初始化脚本或配置，可以在此文件中添加

FROM postgres:15-alpine

# 设置环境变量（这些值会被 docker-compose.yml 中的环境变量覆盖）
ENV POSTGRES_USER=watchtogether
ENV POSTGRES_PASSWORD=watchtogether123
ENV POSTGRES_DB=watchtogether

# 如果需要自定义初始化脚本，可以取消注释以下行
# COPY init-scripts/ /docker-entrypoint-initdb.d/

# 暴露 PostgreSQL 默认端口
EXPOSE 5432

# 使用官方镜像的默认入口点
# 官方镜像已经包含了健康检查和初始化逻辑
